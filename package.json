{
  "name": "playwright-automation-practice",
  "version": "1.0.0",
  "description": "QA Automation for SEP (Secure Enrollment Platform) using Playwright JavaScript",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test",
    "test:report": "playwright show-report",
    "codegen": "playwright codegen https://qa.sep.tdtm.cydeo.com/taws"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "sep",
    "qaa"
  ],
  "author": "QA Automation Team",
